# Connected MT5 Terminal MCP Streamable HTTP endpoint.
MT5_MCP_URL=http://127.0.0.1:22346/mcp

# Leave empty in source control. Copy this file to .env and set the token locally.
MT5_MCP_TOKEN=

# Collector tuning (all optional).
MT5_MCP_TIMEOUT_SECONDS=30
MT5_TICK_LOOKBACK_MINUTES=10
MT5_TICK_REQUEST_LIMIT=10000
MT5_TICK_SNAPSHOT_LIMIT=200
MT5_AVERAGE_RANGE_BARS=20
MT5_DIRECTION_BARS=5

# Deterministic MarketGate thresholds (conservative demo defaults).
XAUUSD_GATE_MAX_QUOTE_AGE_SECONDS=15
XAUUSD_GATE_MAX_TICK_AGE_SECONDS=15
XAUUSD_GATE_MAX_FUTURE_CLOCK_SKEW_SECONDS=2
XAUUSD_GATE_MAX_SPREAD_POINTS=50
XAUUSD_GATE_MAX_SPREAD_TO_M1_RANGE_RATIO=0.35
XAUUSD_GATE_MIN_M1_CANDLES=100
XAUUSD_GATE_MIN_M5_CANDLES=100
XAUUSD_GATE_MIN_RECENT_TICKS=20
XAUUSD_GATE_SPIKE_LOOKBACK_BARS=20
XAUUSD_GATE_MAX_M1_SPIKE_RATIO=3.0
XAUUSD_GATE_MAX_M5_SPIKE_RATIO=3.0
XAUUSD_GATE_DIRECTION_M1_BARS=5
XAUUSD_GATE_DIRECTION_M5_BARS=5
XAUUSD_GATE_DIRECTION_FLAT_RANGE_FRACTION=0.10
XAUUSD_GATE_REQUIRE_DIRECTIONAL_ALIGNMENT=true
XAUUSD_GATE_REJECT_EXISTING_POSITION=true
XAUUSD_GATE_MIN_FREE_MARGIN=50

# USD economic-news gate. All times are evaluated against MT5 trade-server time.
XAUUSD_NEWS_BLACKOUT_BEFORE_MINUTES=30
XAUUSD_NEWS_BLACKOUT_AFTER_MINUTES=30
XAUUSD_NEWS_LOOKBACK_MINUTES=120
XAUUSD_NEWS_LOOKAHEAD_MINUTES=1440
XAUUSD_NEWS_REQUEST_LIMIT=1000

# Advisory-only OpenAI integration. Leave the key empty in source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_PAYLOAD_M1_CANDLES=30
OPENAI_PAYLOAD_M5_CANDLES=20

# Persistent duplicate protection and usage/cost limits.
XAUUSD_AI_STATE_DB=.state/xauusd_bot.sqlite3
OPENAI_MAX_CALLS_PER_DAY=30
OPENAI_DAILY_SPEND_CAP_USD=0.65
OPENAI_WEEKLY_SPEND_CAP_USD=5.00
OPENAI_BUDGET_RESERVE_PER_CALL_USD=0.05
OPENAI_INPUT_USD_PER_MILLION=2.00
OPENAI_CACHED_INPUT_USD_PER_MILLION=0.10
OPENAI_CACHE_WRITE_USD_PER_MILLION=2.50
OPENAI_OUTPUT_USD_PER_MILLION=10.00
OPENAI_MAX_PRICE_DISTANCE_VOLATILITY_MULTIPLE=10.0
LOG_LEVEL=INFO
